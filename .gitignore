.env
mcp/gateway.env

# Rust build output (scripts/management)
scripts/management/target/

# rust-inference スタブクレート（Docker ビルドが本体）
rust-inference/target/
rust-inference/Cargo.lock

llm-gateway-proxy/target/

# download-hf-gguf.sh が作成する Hugging Face 用 venv（PEP 668 回避）
.venv-hf-download/

# ローカル推論用 GGUF（大容量・Hugging Face から取得）
storage/rust-inference-models/*.gguf
storage/rust-inference-models/.cache/

# Crew per-agent runtime artifacts — not committed (see crew/README.md, workflow_contract.md).
# Templates under crew/_template/ stay tracked via negation rules.
crew/*/work_logs/
!crew/_template/work_logs/
!crew/_template/work_logs/**

crew/*/TASKS_*.md
crew/*/TASKS_*.MD
!crew/_template/TASKS_TEMPLATE.md
!crew/_template/worklog_TEMPLATE.md
