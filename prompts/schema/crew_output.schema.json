{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrewOutputContractV1",
  "type": "object",
  "required": [
    "agent_name",
    "task_id",
    "summary",
    "actions",
    "risks",
    "confidence",
    "handoff"
  ],
  "properties": {
    "agent_name": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "owner",
          "due"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk",
          "impact",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "handoff": {
      "type": "object",
      "required": [
        "next_owner",
        "first_step"
      ],
      "properties": {
        "next_owner": {
          "type": "string"
        },
        "first_step": {
          "type": "string"
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "self_check": {
      "type": "object",
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "policy_compliant": {
          "type": "boolean"
        },
        "assumptions_listed": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": false
}