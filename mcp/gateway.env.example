# =============================================================================
# ZeroClaw MCP Gateway Environment Variables (Imperial Arsenal)
# =============================================================================

# --- 1. Search & Intelligence (調査・インテリジェンス) ---
# Brave Search API: 調査部・戦略部のメインエンジン
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Google Maps API: 市場調査・物理リサーチ用（必要に応じて）
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# --- 2. Development & Version Control (開発・コード管理) ---
# GitHub Personal Access Token: PR作成・Issue管理・コード解析に必須
# 権限: repo, workflow, read:org, write:discussion
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# GitLab (オプション: 社内リポジトリがGitLabの場合)
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-your_token_here

# --- 3. Languages & Runtimes (多言語実行環境) ---
# NPM / GitHub Packages 認証 (JS部隊用)
NPM_TOKEN=npm_...
# Composer / Packagist 認証 (PHP部隊用)
COMPOSER_AUTH_JSON='{"github-oauth": {"github.com": "your_token"}}'

# --- 4. Specialized Knowledge & RAG (ナレッジ基盤) ---
# Context7 API: 過去の資産・設計書の深層検索用
CONTEXT7_API_KEY=c7_your_context7_key_here

# Notion API: 社内Wiki連携用
NOTION_API_KEY=secret_your_notion_key_here
NOTION_DATABASE_ID=your_database_id_here

# Atlassian (Confluence/Jira) 連携用
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your_atlassian_token_here

# --- 5. Quality, Monitoring & Testing (品質・監視・テスト) ---
# Sentry Auth Token: エラー監視・デバッグ部隊用
SENTRY_AUTH_TOKEN=your_sentry_token_here
SENTRY_ORG=your-org-slug

# Browserbase: ブラウザ操作・UIテスト・VRT用
BROWSERBASE_API_KEY=bb_your_browserbase_key_here
BROWSERBASE_PROJECT_ID=your_project_id_here

# --- 6. Security & Compliance (セキュリティ・法務) ---
# Snyk Token: 脆弱性スキャン・監査部隊用
SNYK_TOKEN=your_snyk_token_here

# HashiCorp Vault: 機密情報管理用
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=hvs.your_vault_root_token_here

# --- 7. Infrastructure & Platform (インフラ・プラットフォーム) ---
# AWS Credentials: IaC・クラウド構築部隊用
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_aws_secret_here
AWS_REGION=ap-northeast-1

# Kubernetes: Kubeconfigパス（コンテナ内マウント位置）
KUBECONFIG=/app/vault/kubeconfig

# --- 8. Communication (コミュニケーション) ---
# Discord Webhook: 進行管理・通知用
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Slack Bot Token: 社内チャット連携用
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_APP_TOKEN=xapp-your-token-here

# --- 9. Database Connections (データベース接続) ---
# MCPサーバーが個別にDBを叩くための接続文字列
POSTGRES_URL=postgresql://imperial_admin:secure_pass@postgres:5432/zeroclaw_enterprise
REDIS_URL=redis://redis:6379/0