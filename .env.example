# =============================================================================
# 1. Core System Settings (システム基本設定)
# =============================================================================
ZEROCLAW_PORT=42617
ZEROCLAW_LOG_LEVEL=info
ZEROCLAW_AUDIT_LOG=true
ZEROCLAW_DB_NAME=zeroclaw_enterprise

# =============================================================================
# 2. LLM Gateway & API Keys (LiteLLM / OpenAI / Anthropic)
# =============================================================================
# LiteLLMのマスターキー（config.tomlの${LITELLM_MASTER_KEY}に対応）
LITELLM_MASTER_KEY=sk-zero-claw-sovereign-64-2026

# 各プロバイダーのAPIキー (クラウドLLM利用時の追加設定項目)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
MISTRAL_API_KEY=...

# 推論モデルのデフォルト設定 (バニラ状態: Ollama gemma3:12b)
DEFAULT_MODEL=gemma3:12b
FALLBACK_MODEL=openai/gpt-4-turbo

# =============================================================================
# 3. Persistence & Cache (PostgreSQL / Redis)
# =============================================================================
POSTGRES_USER=imperial_admin
POSTGRES_PASSWORD=secure_password_999
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# =============================================================================
# 4. Source Control & Development (GitHub / Git)
# =============================================================================
# GitHubエージェントがPR作成やIssue操作を行うためのPAT
GITHUB_PAT=ghp_...
GITHUB_ORG=your-org-name

# =============================================================================
# 5. Search & Global Intelligence (Brave / DDG / Arxiv)
# =============================================================================
BRAVE_SEARCH_API_KEY=bs_...
# WikipediaやArxivは通常APIキー不要だが、レート制限回避用の登録がある場合は以下
ARXIV_USER_ID=...

# =============================================================================
# 6. Specialized Knowledge & RAG (Context7)
# =============================================================================
# 過去の設計資産やWikiを深層検索するためのキー
CONTEXT7_API_KEY=c7_...

# =============================================================================
# 7. Testing & Quality Assurance (Browserbase / Sentry)
# =============================================================================
# UIテスト（browserbase）用
BROWSERBASE_API_KEY=...
BROWSERBASE_PROJECT_ID=...

# エラー監視（Sentry）用
SENTRY_AUTH_TOKEN=sntryu_...
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# =============================================================================
# 8. Security & Compliance (Snyk / Vault / Legal)
# =============================================================================
# 脆弱性スキャン（Snyk）用
SNYK_TOKEN=...

# 機密情報管理（HashiCorp Vault）用
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=hvs....

# 法務データベースアクセス用（API契約がある場合）
LEGAL_DB_API_KEY=...

# =============================================================================
# 9. Infrastructure & Cloud (AWS / GCP / Kubernetes)
# =============================================================================
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-northeast-1

# Kubernetes操作用（Kubeconfigのパス等）
KUBECONFIG_PATH=/app/vault/kubeconfig

# =============================================================================
# 10. Communication & Collaboration (Discord / Slack / Notion)
# =============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C...

NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=...

CONFLUENCE_API_TOKEN=...
CONFLUENCE_EMAIL=...
CONFLUENCE_URL=https://your-domain.atlassian.net

# =============================================================================
# 11. Polyglot Runtimes (Sandboxing)
# =============================================================================
# 各言語のビルド・実行時に必要な環境変数
# Task（dotenv）と互換になるよう、GITHUB_PAT 相当の文字列を JSON 内に直接書いてください（${...} 展開は使わない）
COMPOSER_AUTH={"github-oauth":{"github.com":"ghp_replace_me"}}
CARGO_HOME=/app/.cargo
GOPATH=/app/go
NODE_ENV=production

# =============================================================================
# 12. Rust 管理 CLI (scripts/management) — 任意
# =============================================================================
# 未設定時は POSTGRES_* / ZEROCLAW_DB_NAME から接続 URL を組み立てます（ホスト実行時は POSTGRES_HOST=localhost 等）。
# DATABASE_URL=postgresql://imperial_admin:secure_password_999@localhost:5432/zeroclaw_enterprise
# IMPERIAL_OLLAMA_URL=http://127.0.0.1:11434
# IMPERIAL_LITELLM_URL=http://127.0.0.1:4000
# IMPERIAL_OLLAMA_EMBED_MODEL=nomic-embed-text
# カンマ区切りで Markdown を再帰走査（例: prompts のみ取り込み）
# IMPERIAL_KNOWLEDGE_DIRS=prompts